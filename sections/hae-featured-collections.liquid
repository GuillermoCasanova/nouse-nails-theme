<link
  rel='stylesheet'
  href='{{ 'hae-featured-collections.css' | asset_url }}'
  media='print'
  onload="this.media='all'"
>

<section class='featured-collections' style='position: relative;'>
  <h2 class='visually-hidden'>Featured Collections</h2>
  <div class='featured-collections__layout grid grid-2 grid-gap-0'>
    {% for block in section.blocks %}
      <div
        class='featured-collections__column color-{{ block.settings.color_scheme }}'
      >
        <div class='featured-collections__column__layout section-padding-small'>
          <div class='featured-collections__column__media-wrapper'>
            <div class='featured-collections__column__sticker'>
              {% render 'floating-sticker',
                sticker_type: block.settings.floating_sticker,
                custom_class: 'product-sticker-hover',
                color: block.settings.sticker_color
              %}
            </div>
            <div class='featured-collections__column__media'>
              {% if block.settings.media_type == 'video'
                and block.settings.video_url != blank
              %}
                {% render 'accessible-video',
                  src: block.settings.video_url,
                  caption: block.settings.video_caption,
                  class: 'responsive-image'
                %}
              {% else %}
                {% render 'image-with-aspect-ratio',
                  image: block.settings.image,
                  aspect_ratio: '1/1',
                  alt: block.settings.image.alt,
                  sizes: '(min-width: 940px) calc(50vw - 5rem), (min-width: 750px) calc(50vw - 4rem), calc(100vw - 4rem)',
                  widths: '280, 348, 480, 640, 768'
                %}
              {% endif %}
              <div class='featured-collections__column__button-wrapper'>
                <div class='button  button--primary  button--small'>
                  {{ block.settings.button_text }}
                </div>
              </div>
            </div>
          </div>

          <div class='featured-collections__column__text-wrapper'>
            <div class='featured-collections__column__text'>
              <h3
                class='featured-collections__column__headline headline-style-h1'
              >
                <a
                  class='featured-collections__column__heading-link'
                  href='{{ block.settings.collection_url }}'
                >
                  {{ block.settings.headline }}
                </a>
              </h3>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Callouts",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "background-1"
        },
        {
          "type": "url",
          "id": "collection_url",
          "label": "Collection link"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "select",
          "id": "media_type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "label": "Media type",
          "default": "image"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "paragraph",
          "content": "Video caption is for accessibility, not an on-screen subtitle. Leave it blank if the video is decorative — it will be hidden from screen readers. If the video conveys information (a product demo, technique, etc.), add a short description so assistive technology can announce it. Informative videos also show a pause control. All videos pause automatically when a visitor prefers reduced motion."
        },
        {
          "type": "textarea",
          "id": "video_caption",
          "label": "Video Caption",
          "info": "Required for informative video. Leave blank for decorative video (hidden from screen readers)."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "floating_sticker",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "stars", "label": "Stars" },
            { "value": "sun-blue", "label": "Sun Blue" },
            { "value": "sun-pink", "label": "Sun Pink" }
          ],
          "label": "Floating sticker",
          "default": "none"
        },
        {
          "type": "color",
          "id": "sticker_color",
          "label": "Sticker color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Callouts",
      "category": "Custom HAE Sections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
