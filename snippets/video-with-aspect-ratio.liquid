{% doc %}
  Renders a video with a configurable aspect ratio, accessibility caption,
  reduced-motion pause, and a pause control when the video is informative.

  @param {object} video - Shopify-hosted video object
  @param {string} [aspect_ratio] - Aspect ratio (e.g. '16/9'). Default 16/9
  @param {boolean} [autoplay] - Whether to autoplay the video
  @param {boolean} [loop] - Whether to loop the video
  @param {boolean} [controls] - Whether to show native video controls
  @param {boolean} [muted] - Whether to mute the video
  @param {string} [class] - Additional CSS classes
  @param {image} [placeholder_image] - Optional placeholder image
  @param {boolean} [motion_reduce] - Whether to add motion-reduce class
  @param {string} [caption] - Accessible caption. Blank = decorative (aria-hidden)

  @example
  {% render 'video-with-aspect-ratio',
    video: block.settings.video,
    aspect_ratio: '16/9',
    autoplay: true,
    caption: block.settings.video_caption
  %}
{% enddoc %}

{%- liquid
  assign aspect_ratio = aspect_ratio | default: '16/9'
  assign autoplay = autoplay | default: false
  assign loop = loop | default: false
  assign controls = controls | default: false
  assign muted = muted | default: false
  assign class = class | default: ''
  assign motion_reduce = motion_reduce | default: false

  assign video_class = ''
  if motion_reduce
    assign video_class = 'motion-reduce'
  endif
-%}

<div class="video-with-aspect-ratio {{ class }}" style="--aspect-ratio: {{ aspect_ratio }};">
  <div class="video-with-aspect-ratio__inner">
    {%- if video != blank -%}
      {% render 'accessible-video',
        video: video,
        caption: caption,
        class: video_class,
        autoplay: autoplay,
        loop: loop,
        muted: muted,
        controls: controls
      %}
    {%- elsif placeholder_image != blank -%}
      <img
        src="{{ placeholder_image | image_url: width: 800 }}"
        alt="{{ placeholder_image.alt | escape }}"
        loading="lazy"
        width="800"
        height="800"
        class="video-with-aspect-ratio__placeholder-image"
      >
    {%- else -%}
      <div class="video-with-aspect-ratio__placeholder">
        <svg class="placeholder-svg" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
          <rect width="400" height="300" fill="#f4f4f4"/>
          <text x="50%" y="50%" text-anchor="middle" dy=".3em" fill="#999" font-size="16">Video</text>
        </svg>
      </div>
    {%- endif -%}
  </div>
</div>
