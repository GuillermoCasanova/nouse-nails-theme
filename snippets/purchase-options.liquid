{% doc %}
  Renders one-time vs subscribe purchase options from Shopify selling plans.

  @param {product} product - Product with selling plan groups
  @param {string} [section_id] - Section id for unique input ids
  @param {object} [block] - Buy buttons block (consent and policy settings)

  @example
  {% render 'purchase-options', product: product, section_id: section.id, block: block %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign plan_groups = product.selling_plan_groups
  assign max_percent = 0
  assign min_percent = 100
  assign has_percent_discount = false
  assign plan_count = 0

  if plan_groups.size > 0
    for group in plan_groups
      for plan in group.selling_plans
        assign plan_count = plan_count | plus: 1
        assign adjustment = plan.price_adjustments.first
        if adjustment and adjustment.value_type == 'percentage'
          assign has_percent_discount = true
          if adjustment.value > max_percent
            assign max_percent = adjustment.value
          endif
          if adjustment.value < min_percent
            assign min_percent = adjustment.value
          endif
        endif
      endfor
    endfor
  endif

  assign option_id = section_id | default: product.id
  assign subscribe_only = false
  if product.requires_selling_plan
    assign subscribe_only = true
  endif

  assign policy_modal_id = 'SubscriptionPolicyModal-' | append: option_id
  assign policy_page = null
  assign custom_consent = null
  if block != blank
    assign policy_page = block.settings.subscription_policy_page
    assign custom_consent = block.settings.subscription_consent
  endif
  assign policy_modal_body = blank
  assign policy_modal_url = shop.subscription_policy.url

  if policy_page != blank
    assign policy_modal_title = policy_page.title
    assign policy_modal_body = policy_page.content
  elsif shop.subscription_policy.body != blank
    assign policy_modal_title = 'products.product.purchase_options.subscription_policy_modal_title' | t
    assign policy_modal_body = shop.subscription_policy.body
  else
    assign policy_modal_title = 'products.product.purchase_options.subscription_policy_modal_title' | t
  endif
-%}

{%- if plan_groups.size > 0 and plan_count > 0 -%}
  {{ 'component-purchase-options.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-popup-modal.css' | asset_url | stylesheet_tag }}
  <script src='{{ 'purchase-options.js' | asset_url }}' defer></script>

  <purchase-options
    class='purchase-options{% if subscribe_only %} purchase-options--subscribe-only{% endif %}'
    data-section='{{ option_id }}'
  >
    <div class='purchase-options__consent'>
      <small class='purchase-options__consent-text'>
        {%- if custom_consent != blank -%}
          {{ custom_consent }}
        {%- else -%}
          {%- capture policy_link -%}
            <modal-opener
              class='product-popup-modal__opener purchase-options__policy-opener'
              data-modal='#{{ policy_modal_id }}'
            >
              <button
                type='button'
                class='product-popup-modal__button link purchase-options__policy-link'
                aria-haspopup='dialog'
              >
                {{ 'products.product.purchase_options.cancellation_policy' | t }}
              </button>
            </modal-opener>
          {%- endcapture -%}
          {{
            'products.product.purchase_options.consent_html'
            | t: policy_link: policy_link
          }}
        {%- endif -%}
      </small>
    </div>

    <div class='purchase-options__panel'>
      <fieldset class='purchase-options__fieldset'>
        <legend class='visually-hidden'>
          {{ 'products.product.purchase_options.heading' | t }}
        </legend>

        <div class='purchase-options__cards'>
          {%- unless subscribe_only -%}
            <label class='purchase-options__card' for='PurchaseOptions-Once-{{ option_id }}'>
              <input
                type='radio'
                id='PurchaseOptions-Once-{{ option_id }}'
                name='selling_plan'
                value=''
                class='purchase-options__input visually-hidden'
                data-purchase-option='once'
                checked
              >
              <span class='purchase-options__card-body'>
                <span class='purchase-options__icon' aria-hidden='true'>
                  <svg viewBox='0 0 72 72' fill='currentColor'>
                    <g opacity='0.8'>
                      <path d='M30 6L13.5 13.5L18 16.5L31.5 22.5L36 33L40.5 22.5L54 16.5L58.5 13.5L42 6L36 18L30 6Z' fill='black' fill-opacity='0.2'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M4.38849 10.3276L30.7645 20.2186L36 33.3073L41.2355 20.2186L67.6116 10.3276L61 30.1622V55.6139C61 56.8645 60.2243 57.9838 59.0534 58.4229L36 67.0679L12.9467 58.4229C11.7757 57.9838 11 56.8645 11 55.6139V30.1622L4.38849 10.3276ZM7.61156 13.6723L13 29.8376V55.6139C13 56.0308 13.2586 56.4039 13.6489 56.5503L36 64.9319L58.3512 56.5503C58.7415 56.4039 59 56.0308 59 55.6139V29.8376L64.3885 13.6722L42.7645 21.7812L36 38.6925L29.2355 21.7812L7.61156 13.6723Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M36.12 19.9325L41.6899 22.0132L40.99 23.8868L36.12 22.0675L31.01 23.9768L30.31 22.1033L36.12 19.9325Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M41.4523 4.67666L61.0545 13.0911L60.2656 14.9289L42.5477 7.32335L36.9285 21.3714L35.0715 20.6286L41.4523 4.67666Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M30.5477 4.67666L36.9285 20.6286L35.0715 21.3714L29.4523 7.32335L11.7345 14.9289L10.9456 13.0911L30.5477 4.67666Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M35.8245 39.4682L11.8245 30.4682L12.1756 29.5318L36.1756 38.5318L35.8245 39.4682Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M36.1755 39.4682L60.1755 30.4682L59.8244 29.5318L35.8244 38.5318L36.1755 39.4682Z' fill='currentColor'/>
                      <path fill-rule='evenodd' clip-rule='evenodd' d='M36.5 39V66H35.5V39H36.5Z' fill='currentColor'/>
                    </g>
                  </svg>
                </span>
                <span class='purchase-options__text'>
                  {{ 'products.product.purchase_options.one_time' | t }}
                </span>
              </span>
            </label>
          {%- endunless -%}

          <button
            type='button'
            class='purchase-options__card purchase-options__card--subscribe'
            data-subscribe-card
          >
            <span class='purchase-options__card-body'>
              <span class='purchase-options__icon' aria-hidden='true'>
                <svg viewBox='0 0 72 72' fill='currentColor'>
                  <g opacity='0.8'>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M11 16C10.4477 16 10 16.4477 10 17V32.01H8V17C8 15.3431 9.34315 14 11 14H40C41.6569 14 43 15.3431 43 17V49H40.95V47H41V17C41 16.4477 40.5523 16 40 16H11Z' fill='currentColor'/>
                    <path d='M51 54C54.3137 54 57 51.3137 57 48C57 44.6863 54.3137 42 51 42C47.6863 42 45 44.6863 45 48C45 51.3137 47.6863 54 51 54Z' fill='currentColor' fill-opacity='0.2'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M51 43C48.2386 43 46 45.2386 46 48C46 50.7614 48.2386 53 51 53C53.7614 53 56 50.7614 56 48C56 45.2386 53.7614 43 51 43ZM44 48C44 44.134 47.134 41 51 41C54.866 41 58 44.134 58 48C58 51.866 54.866 55 51 55C47.134 55 44 51.866 44 48Z' fill='currentColor'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M53.5858 22H42V20H54.4142L67 32.5858V49H57V47H65V33.4142L53.5858 22Z' fill='currentColor'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M50.5 28.7929L55.2071 33.5H50.5V28.7929ZM51.5 31.2071V32.5H52.7929L51.5 31.2071Z' fill='currentColor'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M42 47H45V49H42V47Z' fill='currentColor'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M24 24.94C14.6112 24.94 7 32.5512 7 41.94C7 51.3288 14.6112 58.94 24 58.94C33.3888 58.94 41 51.3288 41 41.94C41 32.5512 33.3888 24.94 24 24.94ZM5 41.94C5 31.4466 13.5066 22.94 24 22.94C34.4934 22.94 43 31.4466 43 41.94C43 52.4334 34.4934 60.94 24 60.94C13.5066 60.94 5 52.4334 5 41.94Z' fill='currentColor'/>
                    <path fill-rule='evenodd' clip-rule='evenodd' d='M23.5 32.94H24.5V41.7329L30.3536 47.5864L29.6464 48.2936L23.5 42.1471V32.94Z' fill='currentColor'/>
                  </g>
                </svg>
              </span>
              <span class='purchase-options__text'>
                {{ 'products.product.purchase_options.subscribe' | t }}
                {%- if has_percent_discount -%}
                  {%- assign discount_label = max_percent | append: '%' -%}
                  <span class='purchase-options__discount'>
                    {%- if min_percent != max_percent -%}
                      {{ 'products.product.purchase_options.save_up_to' | t: discount: discount_label }}
                    {%- else -%}
                      {{ 'products.product.purchase_options.save' | t: discount: discount_label }}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
            </span>
          </button>
        </div>

        <fieldset class='purchase-options__frequencies'>
          <legend class='visually-hidden'>
            {{ 'products.product.purchase_options.frequency_heading' | t }}
          </legend>
          <div class='purchase-options__frequency-list'>
            {%- for group in plan_groups -%}
              {%- for plan in group.selling_plans -%}
                {%- liquid
                  assign allocation = nil
                  for alloc in current_variant.selling_plan_allocations
                    if alloc.selling_plan.id == plan.id
                      assign allocation = alloc
                    endif
                  endfor

                  assign compare_price = current_variant.price
                  assign delivery_price = current_variant.price
                  if allocation
                    assign delivery_price = allocation.per_delivery_price | default: allocation.price
                    if allocation.compare_at_price > 0
                      assign compare_price = allocation.compare_at_price
                    endif
                  endif

                  assign formatted_delivery = delivery_price | money
                  assign formatted_compare = compare_price | money
                  assign adjustment = plan.price_adjustments.first
                  assign discount_text = ''
                  if adjustment and adjustment.value_type == 'percentage'
                    assign discount_value = adjustment.value | append: '%'
                    assign discount_text = 'products.product.purchase_options.frequency_off' | t: discount: discount_value, price: formatted_compare
                  endif
                -%}
                <label
                  class='purchase-options__frequency'
                  for='PurchaseOptions-Plan-{{ plan.id }}-{{ option_id }}'
                >
                  <input
                    type='radio'
                    id='PurchaseOptions-Plan-{{ plan.id }}-{{ option_id }}'
                    name='selling_plan'
                    value='{{ plan.id }}'
                    class='purchase-options__input visually-hidden'
                    data-selling-plan-option
                    {% if subscribe_only and forloop.first and forloop.parentloop.first %}
                      checked
                    {% endif %}
                  >
                  <span class='purchase-options__frequency-body'>
                    <span class='purchase-options__radio' aria-hidden='true'>
                      <svg class='purchase-options__radio-unchecked' viewBox='0 0 18 18' fill='none'>
                        <circle cx='9' cy='9' r='9' fill='white' fill-opacity='0.1'/>
                        <circle cx='9' cy='9' r='8.5' stroke='currentColor' stroke-opacity='0.35'/>
                      </svg>
                      <svg class='purchase-options__radio-checked' viewBox='0 0 24 24'>
                        <path fill='currentColor' d='M24,12 C24,18.627 18.627,24 12,24 C5.373,24 0,18.627 0,12 C0,5.373 5.373,0 12,0 C18.627,0 24,5.373 24,12 Z M7.0050175,11.4087067 C6.61372743,11.0189496 5.98056367,11.0201924 5.59080666,11.4114825 C5.20104965,11.8027726 5.20229244,12.4359363 5.5935825,12.8256933 L9.9325825,17.1476933 C10.3226506,17.5362331 10.9534086,17.5363886 11.3436681,17.1480412 L19.5076681,9.02404115 C19.8991503,8.63447708 19.9007052,8.00131401 19.5111412,7.60983186 C19.1215771,7.2183497 18.488414,7.21679478 18.0969319,7.60635885 L10.6386478,15.0281006 L7.0050175,11.4087067 Z'/>
                      </svg>
                    </span>
                    <span class='purchase-options__frequency-copy'>
                      <span class='purchase-options__frequency-name'>
                        {{ plan.name }}
                        {%- if discount_text != '' -%}
                          <span class='purchase-options__frequency-off'> {{ discount_text }}</span>
                        {%- endif -%}
                      </span>
                      <span class='purchase-options__frequency-price'>
                        {{ 'products.product.purchase_options.per_delivery' | t: price: formatted_delivery }}
                      </span>
                    </span>
                  </span>
                </label>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </fieldset>
      </fieldset>

      <details class='purchase-options__details'>
        <summary class='purchase-options__details-summary'>
          <span class='purchase-options__details-icon' aria-hidden='true'>
            <svg viewBox='0 0 16 16' fill='none'>
              <circle cx='8' cy='8' r='7' stroke='currentColor' stroke-width='1.2'/>
              <path d='M8 7.2V11.2' stroke='currentColor' stroke-width='1.2' stroke-linecap='round'/>
              <circle cx='8' cy='5' r='0.7' fill='currentColor'/>
            </svg>
          </span>
          <span class='purchase-options__details-label'>
            {{ 'products.product.purchase_options.details_label' | t }}
          </span>
          <span class='purchase-options__details-chevron' aria-hidden='true'>
            <svg viewBox='0 0 10 10' fill='none'>
              <path d='M3.2 1 7 5 3.2 9' stroke='currentColor' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'/>
            </svg>
          </span>
        </summary>
        <div class='purchase-options__details-content'>
          <p class='purchase-options__details-heading'>
            {{ 'products.product.purchase_options.details_heading' | t }}
          </p>
          <p class='purchase-options__details-text'>
            {{ 'products.product.purchase_options.details' | t }}
          </p>
        </div>
      </details>
    </div>
  </purchase-options>

  <modal-dialog
    id='{{ policy_modal_id }}'
    class='product-popup-modal purchase-options__policy-modal'
  >
    <div
      role='dialog'
      aria-modal='true'
      aria-label='{{ policy_modal_title | escape }}'
      class='product-popup-modal__content'
      tabindex='-1'
    >
      <button
        id='ModalClose-{{ policy_modal_id }}'
        type='button'
        class='product-popup-modal__toggle'
        aria-label='{{ 'accessibility.close' | t }}'
      >
        {% render 'icon-close' %}
      </button>
      <div class='product-popup-modal__content-info rte'>
        <h2 class='h2 purchase-options__policy-modal-title'>
          {{ policy_modal_title | escape }}
        </h2>
        {%- if policy_modal_body != blank -%}
          {{ policy_modal_body }}
        {%- else -%}
          <p>{{ 'products.product.purchase_options.subscription_policy_empty' | t }}</p>
          {%- if policy_modal_url != blank -%}
            <p>
              <a href='{{ policy_modal_url }}'>
                {{- 'products.product.purchase_options.subscription_policy_view_online' | t -}}
              </a>
            </p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </modal-dialog>
{%- endif -%}
